{% extends "_layouts/cp" %}

{% block actionButton %}
    <div class="btngroup">
        <a class="btn submit add icon" href="{{ cpUrl(baseCpPath ~ '/new') }}">{{ 'New key pair'|t('keychain') }}</a>
        <button type="button" class="btn submit menubtn" aria-label="{{ 'More options'|t('app') }}"></button>
        <div class="menu">
            <ul>
                <li><a href="{{ cpUrl(baseCpPath ~ '/new-openssl') }}">{{ 'Generate OpenSSL key pair'|t('keychain') }}</a></li>
            </ul>
        </div>
    </div>
{% endblock %}

{% block content %}
    {% if keypairs|length %}
        <table class="data fullwidth collapsible">
            <thead>
            <tr>
                <th scope="col">{{ 'Description'|t('keychain') }}</th>
                <th scope="col">{{ 'Date Created'|t('app') }}</th>
                <th scope="col">{{ 'Date Updated'|t('app') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for keypair in keypairs %}
                <tr>
                    <th scope="row" data-title="{{ 'Description'|t('keychain') }}">
                        <span class="status {{ keypair.enabled ? 'active' : 'inactive' }}"
                              title="{{ keypair.enabled ? 'Enabled'|t('app') : 'Disabled'|t('app') }}"></span>
                        <a href="{{ cpUrl(baseCpPath ~ '/' ~ keypair.id) }}">{{ keypair.description ?: 'Key pair'|t('keychain') }}</a>
                    </th>
                    <td data-title="{{ 'Date Created'|t('app') }}">{{ keypair.dateCreated|date('short') }}</td>
                    <td data-title="{{ 'Date Updated'|t('app') }}">{{ keypair.dateUpdated|date('short') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ 'No key pairs exist yet.'|t('keychain') }}</p>
    {% endif %}
{% endblock %}
