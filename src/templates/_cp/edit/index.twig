{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set fullPageForm = true %}

{% block details %}
    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">{{ "Status"|t('app') }}</dt>
            <dd class="value flex">
                <div class="flex-grow">
                    <span class="status {{ keypair.enabled ? 'active' : 'inactive' }}"></span>
                    {{ keypair.enabled ? "Enabled"|t('app') : "Disabled"|t('app') }}
                </div>
                {% if actions|length %}
                    <div>
                        <button type="button" id="action-menubtn" class="btn menubtn" data-icon="settings"
                                title="{{ 'Actions'|t('app') }}" aria-label="{{ 'Actions'|t('app') }}"></button>
                        <div class="menu">
                            {% for actionList in actions %}
                                {% if not loop.first %}<hr>{% endif %}
                                <ul>
                                    {% for actionItem in actionList %}
                                        <li><a
                                                {%- if actionItem.id is defined %} id="{{ actionItem.id }}"{% endif %}
                                                {%- if actionItem.action is defined %} class="formsubmit" data-action="{{ actionItem.action }}"{% endif -%}
                                            >{{ actionItem.label }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endfor %}
                        </div>
                        <div id="action-spinner" class="spinner hidden"></div>
                    </div>
                {% endif %}
            </dd>
        </div>
    </dl>

    <div class="meta">
        {{ forms.lightswitchField({
            label: "Encrypt at Rest"|t('keychain'),
            instructions: "Encrypt the key and certificate in the database with Craft's security key."|t('keychain'),
            id: 'isEncrypted',
            name: 'isEncrypted',
            on: keypair.id ? keypair.isEncrypted : true,
            errors: keypair.getErrors('isEncrypted'),
        }) }}
    </div>

    {% if keypair.id %}
        <dl class="meta read-only">
            <div class="data">
                <dt class="heading">{{ "Created at"|t('app') }}</dt>
                <dd class="value">{{ keypair.dateCreated|datetime('short') }}</dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Updated at"|t('app') }}</dt>
                <dd class="value">{{ keypair.dateUpdated|datetime('short') }}</dd>
            </div>
        </dl>
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="{{ baseActionPath }}/upsert">
    <input type="hidden" name="pluginHandle" value="{{ pluginHandle }}">
    {{ redirectInput(baseCpPath) }}
    {% if keypair.id %}<input type="hidden" name="identifier" value="{{ keypair.id }}">{% endif %}

    {{ forms.textField({
        first: true,
        label: "Description"|t('keychain'),
        instructions: "What this key pair is for."|t('keychain'),
        name: "description",
        id: 'description',
        value: keypair.description,
        errors: keypair.getErrors('description'),
    }) }}

    {# The private key is never rendered. For an existing key pair it can be revealed on demand. #}
    {% embed '_includes/forms/field' with {
        label: "Private Key"|t('keychain'),
        instructions: keypair.id ?
            "The PEM-encoded private key. It's hidden: leave this blank to keep the current key, or paste a new one to replace it."|t('keychain') :
            "The PEM-encoded private key."|t('keychain'),
        id: 'key',
        required: not keypair.id,
        errors: keypair.getErrors('key'),
    } %}
        {% block input %}
            {% import '_includes/forms' as forms %}
            {{ forms.textarea({
                class: 'code',
                id: 'key',
                name: 'key',
                rows: 10,
                autocomplete: 'off',
                spellcheck: false,
                placeholder: keypair.id ? '••••••••••••••••••••••••••••••••' : '-----BEGIN PRIVATE KEY-----',
            }) }}
            {% if keypair.id %}
                <div class="buttons">
                    <button type="button" id="reveal-key" class="btn" data-icon="view">{{ "Reveal current key"|t('keychain') }}</button>
                    <div id="reveal-key-spinner" class="spinner hidden"></div>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {{ forms.textareaField({
        label: "Certificate"|t('keychain'),
        instructions: "The PEM-encoded X.509 certificate for the private key."|t('keychain'),
        class: "code",
        id: 'certificate',
        name: 'certificate',
        value: keypair.getDecryptedCertificate(),
        errors: keypair.getErrors('certificate'),
        required: true,
        rows: 10,
    }) }}
{% endblock %}

{% if keypair.id %}
    {% js %}
        (() => {
            const button = document.getElementById('reveal-key');
            const spinner = document.getElementById('reveal-key-spinner');
            const field = document.getElementById('key');
            button.addEventListener('click', () => {
                Craft.elevatedSessionManager.requireElevatedSession(() => {
                    spinner.classList.remove('hidden');
                    Craft.sendActionRequest('POST', '{{ (baseActionPath ~ '/upsert/reveal-key')|e('js') }}', {
                        data: {identifier: {{ keypair.id|json_encode|raw }}},
                    })
                        .then(({data}) => {
                            field.value = data.key;
                            button.closest('.buttons').remove();
                        })
                        .catch(() => Craft.cp.displayError("{{ 'Couldn’t reveal the key.'|t('keychain')|e('js') }}"))
                        .finally(() => spinner.classList.add('hidden'));
                });
            });
        })();
    {% endjs %}
{% endif %}
