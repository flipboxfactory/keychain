#!/usr/bin/env bash
# Stop the KeyChain sandbox and delete its data (database, .env, storage, published assets).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

docker rm -f keychain-sandbox >/dev/null 2>&1 || true
cd "$ROOT/workbench"
rm -rf .env database/*.sqlite* storage bootstrap/cache public/vendor public/cpresources config/craft cms
echo "✔ Sandbox removed"
